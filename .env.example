# Process environment variables are read by the app; this file is an example only.
# Set these values in the server/deployment secret store, never in the UI.
# The three administrator screens read through the FastAPI Dashboard API.
SUBSYNC_DASHBOARD_SOURCE=dashboard_api
SUPABASE_URL=
# Preferred variable name for the new key format.
SUPABASE_SECRET_KEY=
# Backward-compatible alias also accepted by this project.
SUPABASE_KEY=

# FastAPI backend base URL (the backend reads Supabase server-side).
DASHBOARD_API_URL=http://127.0.0.1:8000
DASHBOARD_API_TIMEOUT_SECONDS=8
